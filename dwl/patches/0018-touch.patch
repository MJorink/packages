From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jorink
Date: Wed, 18 Nov 2026 14:14:06 +0100
Subject: [PATCH] touch: touchscreen input

Touch devices are attached to the cursor and mapped to the built-in eDP
panel. Surfaces that accept wl_touch get real touch events; elsewhere
(bar, root, clients without touch) the first finger acts as the left
mouse button, so focus, tag clicks and bindings work as with a pointer.
---
--- a/dwl.c
+++ b/dwl.c
@@ -62,6 +62,7 @@
 #include <wlr/types/wlr_session_lock_v1.h>
 #include <wlr/types/wlr_single_pixel_buffer_v1.h>
 #include <wlr/types/wlr_subcompositor.h>
+#include <wlr/types/wlr_touch.h>
 #include <wlr/types/wlr_viewporter.h>
 #include <wlr/types/wlr_virtual_keyboard_v1.h>
 #include <wlr/types/wlr_virtual_pointer_v1.h>
@@ -374,6 +375,10 @@
