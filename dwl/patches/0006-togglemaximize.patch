From 1ebb3a87eac72937f1b35126d8c71051d37a5218 Mon Sep 17 00:00:00 2001
From: jorink <maxjorink@gmail.com>
Date: Wed, 28 Oct 2026 16:24:18 +0000
Subject: [PATCH 6/9] togglemaximize: maximize a client to the window area

The client covers the monitor's window area (the bar stays visible).
Like mango, a maximized tiled client keeps its cell in the fair layout
and is skipped by the grid resize; floating clients get their previous
geometry back. Focusing another client raises it as usual.
---
 dwl.c | 46 ++++++++++++++++++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 10 deletions(-)

diff --git a/dwl.c b/dwl.c
index b7fbc12..ce7c749 100644
--- a/dwl.c
+++ b/dwl.c
@@ -166,7 +166,8 @@ typedef struct {
 #endif
 	unsigned int bw;
 	uint32_t tags;
-	int isfloating, isurgent, isfullscreen;
+	int isfloating, isurgent, isfullscreen, ismaximized;
+	struct wlr_box premax; /* floating geometry before maximizing */
 	/* fair layout: grid cell and column/row weights (0 = unset) */
 	int col, row;
 	float colper, rowper, oldcolper, oldrowper;
@@ -404,6 +405,7 @@ static void tagmon(const Arg *arg);
 static void tile(Monitor *m);
 static void togglebar(const Arg *arg);
 static void togglefloating(const Arg *arg);
+static void togglemaximize(const Arg *arg);
 static void togglefullscreen(const Arg *arg);
 static void toggletag(const Arg *arg);
 static void toggleview(const Arg *arg);
@@ -642,6 +644,9 @@ arrange(Monitor *m)
 
 	if (m->lt[m->sellt]->arrange)
 		m->lt[m->sellt]->arrange(m);
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && c->ismaximized && !c->isfullscreen)
+			resize(c, m->w, 0);
 	motionnotify(0, NULL, 0, 0, 0, 0);
 	checkidleinhibitor(NULL);
 }
@@ -1901,8 +1906,8 @@ fair(Monitor *m)
 		c->rowper = rowper[ri];
 		c->col = ci;
 		c->row = ri;
-		/* fullscreen clients keep their cell but not its size */
-		if (c->isfullscreen)
+		/* fullscreen and maximized clients keep their cell but not its size */
+		if (c->isfullscreen || c->ismaximized)
 			continue;
 		resize(c, (struct wlr_box){.x = (int)colx[ci], .y = (int)rowy[off + ri],
 			.width = (int)colw[ci], .height = (int)rowh[off + ri]}, 0);
@@ -1937,10 +1942,10 @@ fairresize(Client *gc, int offx, int offy)
 	int maxcol = -1, maxrow = -1, mincol = INT_MAX, minrow = INT_MAX;
 	float dx, dy, d, p, my, adj, newmy, newadj, adjoldc = -1.0f, adjoldr = -1.0f;
 
-	if (!m || gc->isfloating || gc->isfullscreen)
+	if (!m || gc->isfloating || gc->isfullscreen || gc->ismaximized)
 		return;
 	wl_list_for_each(c, &clients, link) {
-		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen || c->ismaximized)
 			continue;
 		n++;
 		maxcol = MAX(maxcol, c->col);
@@ -1973,7 +1978,7 @@ fairresize(Client *gc, int offx, int offy)
 	}
 
 	wl_list_for_each(c, &clients, link) {
-		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen || c->ismaximized)
 			continue;
 		if (c->col == adjc && adjoldc < 0.0f)
 			adjoldc = c->oldcolper;
@@ -2511,7 +2516,7 @@ monocle(Monitor *m)
 	int n = 0;
 
 	wl_list_for_each(c, &clients, link) {
-		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen || c->ismaximized)
 			continue;
 		resize(c, m->w, 0);
 		n++;
@@ -2663,7 +2668,8 @@ moveresize(const Arg *arg)
 	if (cursor_mode != CurNormal && cursor_mode != CurPressed)
 		return;
 	xytonode(cursor->x, cursor->y, NULL, &grabc, NULL, NULL, NULL);
-	if (!grabc || client_is_unmanaged(grabc) || grabc->isfullscreen)
+	if (!grabc || client_is_unmanaged(grabc) || grabc->isfullscreen
+			|| grabc->ismaximized)
 		return;
 
 	if (arg->ui == CurMove && !grabc->isfloating) {
@@ -3527,7 +3533,7 @@ tile(Monitor *m)
 		mw = m->w.width;
 	i = my = ty = 0;
 	wl_list_for_each(c, &clients, link) {
-		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen || c->ismaximized)
 			continue;
 		if (i < m->nmaster) {
 			resize(c, (struct wlr_box){.x = m->w.x, .y = m->w.y + my, .width = mw,
@@ -3556,8 +3562,28 @@ togglefloating(const Arg *arg)
 {
 	Client *sel = focustop(selmon);
 	/* return if fullscreen */
-	if (sel && !sel->isfullscreen)
+	if (sel && !sel->isfullscreen) {
+		sel->ismaximized = 0;
 		setfloating(sel, !sel->isfloating);
+	}
+}
+
+/* Fill the window area (the bar stays visible); tiled clients keep their
+ * place in the layout, floating clients get their old geometry back */
+void
+togglemaximize(const Arg *arg)
+{
+	Client *sel = focustop(selmon);
+	if (!sel || sel->isfullscreen)
+		return;
+	if ((sel->ismaximized = !sel->ismaximized)) {
+		if (sel->isfloating)
+			sel->premax = sel->geom;
+	} else if (sel->isfloating) {
+		resize(sel, sel->premax, 0);
+	}
+	arrange(selmon);
+	wlr_scene_node_raise_to_top(&sel->scene->node);
 }
 
 void
