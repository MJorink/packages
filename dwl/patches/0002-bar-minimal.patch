From aefa8f519068dbba5c369605868d45572a85f1a0 Mon Sep 17 00:00:00 2001
From: jorink <maxjorink@gmail.com>
Date: Wed, 28 Oct 2026 16:24:18 +0000
Subject: [PATCH 2/9] bar-minimal: draw only tags and status text

Drop the layout symbol and window title from the bar (single layout,
titles unused) and stop redrawing the bar on every title change.

statusin(): show the newest line when several status lines arrive in one
read (otherwise a fast volume key repeat could show a stale value), and
do not index the buffer with a negative read() result.
---
 config.def.h |  3 ---
 dwl.c        | 49 ++++++++++++++++++-------------------------------
 2 files changed, 18 insertions(+), 34 deletions(-)

diff --git a/config.def.h b/config.def.h
index 1fc6203..ffbba54 100644
--- a/config.def.h
+++ b/config.def.h
@@ -173,9 +173,6 @@ static const Key keys[] = {
 };
 
 static const Button buttons[] = {
-	{ ClkLtSymbol, 0,      BTN_LEFT,   setlayout,      {.v = &layouts[0]} },
-	{ ClkLtSymbol, 0,      BTN_RIGHT,  setlayout,      {.v = &layouts[2]} },
-	{ ClkTitle,    0,      BTN_MIDDLE, zoom,           {0} },
 	{ ClkStatus,   0,      BTN_MIDDLE, spawn,          {.v = termcmd} },
 	{ ClkClient,   MODKEY, BTN_LEFT,   moveresize,     {.ui = CurMove} },
 	{ ClkClient,   MODKEY, BTN_MIDDLE, togglefloating, {0} },
diff --git a/dwl.c b/dwl.c
index 705704c..2f7cf11 100644
--- a/dwl.c
+++ b/dwl.c
@@ -97,7 +97,7 @@ enum { XDGShell, LayerShell, X11 }; /* client types */
 enum { LyrBg, LyrBottom, LyrTile, LyrFloat, LyrTop, LyrFS, LyrUnmanaged, LyrOverlay,
 	LyrIMPopup, LyrBlock, NUM_LAYERS }; /* scene layers */
 enum { AxisUp, AxisRight, AxisDown, AxisLeft };
-enum { ClkTagBar, ClkLtSymbol, ClkStatus, ClkTitle, ClkClient, ClkRoot }; /* clicks */
+enum { ClkTagBar, ClkStatus, ClkClient, ClkRoot }; /* clicks */
 
 typedef union {
 	int i;
@@ -846,12 +846,8 @@ buttonpress(struct wl_listener *listener, void *data)
 			if (i < LENGTH(tags)) {
 				click = ClkTagBar;
 				arg.ui = 1 << i;
-			} else if (cx < x + TEXTW(selmon, selmon->ltsymbol))
-				click = ClkLtSymbol;
-			else if (cx > selmon->b.width - (TEXTW(selmon, stext) - selmon->lrpad + 2)) {
+			} else if (cx > selmon->b.width - (TEXTW(selmon, stext) - selmon->lrpad + 2))
 				click = ClkStatus;
-			} else
-				click = ClkTitle;
 		}
 
 		/* Change focus if the button was _pressed_ over a client
@@ -1713,20 +1709,10 @@ drawbar(Monitor *m)
 				urg & 1 << i);
 		x += w;
 	}
-	w = TEXTW(m, m->ltsymbol);
-	drwl_setscheme(m->drw, colors[SchemeNorm]);
-	x = drwl_text(m->drw, x, 0, w, m->b.height, m->lrpad / 2, m->ltsymbol, 0);
-
-	if ((w = m->b.width - tw - x) > m->b.height) {
-		if (c) {
-			drwl_setscheme(m->drw, colors[m == selmon ? SchemeSel : SchemeNorm]);
-			drwl_text(m->drw, x, 0, w, m->b.height, m->lrpad / 2, client_get_title(c), 0);
-			if (c && c->isfloating)
-				drwl_rect(m->drw, x + boxs, boxs, boxw, boxw, 0, 0);
-		} else {
-			drwl_setscheme(m->drw, colors[SchemeNorm]);
-			drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
-		}
+	/* no layout symbol or title: fill the gap between tags and status */
+	if ((w = m->b.width - tw - x) > 0) {
+		drwl_setscheme(m->drw, colors[SchemeNorm]);
+		drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
 	}
 
 	wlr_scene_buffer_set_dest_size(m->scene_buffer,
@@ -3065,22 +3051,25 @@ startdrag(struct wl_listener *listener, void *data)
 int
 statusin(int fd, unsigned int mask, void *data)
 {
-	char status[256];
+	char status[512], *line;
 	ssize_t n;
 
 	if (mask & WL_EVENT_ERROR)
 		die("status in event error");
-	if (mask & WL_EVENT_HANGUP)
-		wl_event_source_remove(status_event_source);
-
-	n = read(fd, status, sizeof(status) - 1);
-	if (n < 0 && errno != EWOULDBLOCK)
-		die("read:");
 
+	if ((n = read(fd, status, sizeof(status) - 1)) <= 0) {
+		/* EOF (status command exited) or error: stop reading */
+		if (n == 0 || errno != EAGAIN)
+			wl_event_source_remove(status_event_source);
+		return 0;
+	}
 	status[n] = '\0';
-	status[strcspn(status, "\n")] = '\0';
+	if (status[n - 1] == '\n')
+		status[n - 1] = '\0';
+	/* show the newest line if several were read at once */
+	line = (line = strrchr(status, '\n')) ? line + 1 : status;
 
-	strncpy(stext, status, sizeof(stext));
+	strncpy(stext, line, sizeof(stext) - 1);
 	drawbars();
 
 	return 0;
@@ -3413,8 +3402,6 @@ void
 updatetitle(struct wl_listener *listener, void *data)
 {
 	Client *c = wl_container_of(listener, c, set_title);
-	if (c == focustop(c->mon))
-		drawbars();
 
 	if (c->foreign_toplevel_handle) {
 		struct wlr_ext_foreign_toplevel_handle_v1_state foreign_toplevel_state = {
-- 
