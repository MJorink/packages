From ba4dacc3453e92819c83bacece8424fa309b8120 Mon Sep 17 00:00:00 2001
From: jorink <maxjorink@gmail.com>
Date: Wed, 28 Oct 2026 16:24:19 +0000
Subject: [PATCH 8/9] focusgeom: export the focused window geometry to spawned
 commands

Spawned commands get DWL_FOCUSED_GEOM="X,Y WxH" (layout coordinates,
without borders), the format grim -g expects. It is only computed in the
forked child, so it costs nothing otherwise.
---
 dwl.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/dwl.c b/dwl.c
index c98fa19..601b90f 100644
--- a/dwl.c
+++ b/dwl.c
@@ -3398,11 +3398,21 @@ setup(void)
 void
 spawn(const Arg *arg)
 {
+	Client *c;
+	char geom[64];
+
 	if (fork() == 0) {
 		close(STDIN_FILENO);
 		open("/dev/null", O_RDWR);
 		dup2(STDERR_FILENO, STDOUT_FILENO);
 		setsid();
+		/* Focused window geometry for "grim -g" (dwl has no IPC) */
+		if ((c = focustop(selmon))) {
+			snprintf(geom, sizeof(geom), "%d,%d %dx%d",
+				c->geom.x + (int)c->bw, c->geom.y + (int)c->bw,
+				c->geom.width - 2 * (int)c->bw, c->geom.height - 2 * (int)c->bw);
+			setenv("DWL_FOCUSED_GEOM", geom, 1);
+		}
 		execvp(((char **)arg->v)[0], (char **)arg->v);
 		die("dwl: execvp %s failed:", ((char **)arg->v)[0]);
 	}
