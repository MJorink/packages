From e67cd925ebf2788bc984cc262a9f8d8fbade2b1d Mon Sep 17 00:00:00 2001
From: Jorink
Date: Wed, 18 Nov 2026 11:41:08 +0100
Subject: [PATCH 15/16] gaps between and around tiled windows

The fair layout keeps gappx between tiled windows and around them, so
windows float apart like macOS windows (shadows and rounded corners show).
---
 config.def.h |  1 +
 dwl.c        | 27 +++++++++++++++++----------
 2 files changed, 18 insertions(+), 10 deletions(-)

diff --git a/config.def.h b/config.def.h
index 8df51cb..44b4295 100644
--- a/config.def.h
+++ b/config.def.h
@@ -7,6 +7,7 @@
 static const int sloppyfocus               = 1;  /* focus follows mouse */
 static const int bypass_surface_visibility = 0;  /* 1 means idle inhibitors will disable idle tracking even if it's surface isn't visible  */
 static const unsigned int borderpx         = 1;  /* border pixel of windows */
+static const unsigned int gappx            = 12; /* gap between tiled windows and around them */
 static const int resizestep                = 50; /* keyboard resize step in pixels */
 static const unsigned int snap             = 32; /* snap pixel */
 static const int showbar                   = 1; /* 0 means no bar */
diff --git a/dwl.c b/dwl.c
index ebec5fd..54507eb 100644
--- a/dwl.c
+++ b/dwl.c
@@ -1873,7 +1873,7 @@ drawbars(void)
 }
 
 /* Port of mangowm's "fair" layout (src/layout/horizontal.c, fair_core) and
- * its grid resize (src/layout/arrange.c, resize_tile_grid_fair), without gaps.
+ * its grid resize (src/layout/arrange.c, resize_tile_grid_fair), gappx apart.
  * cols = ceil(sqrt(n)); clients fill the grid column by column. The first
  * (cols - n % cols) columns have n / cols rows, the others one row more.
  * Every column and row has a weight that resizing changes. */
@@ -1893,6 +1893,7 @@ fair(Monitor *m)
 {
 	int i, n = 0, cols, baserows, rem, firstcols, firstcount, maxrows, ci, ri;
 	float *colper, *rowper, *colx, *colw, *rowy, *rowh, sum, avail, next;
+	struct wlr_box a;
 	Client *c, **v;
 
 	wl_list_for_each(c, &clients, link)
@@ -1955,12 +1956,16 @@ fair(Monitor *m)
 		if (rowper[i] == 0.0f)
 			rowper[i] = 1.0f;
 
-	/* The last column/row takes what is left so rounding leaves no gap */
-	avail = (float)m->w.width;
-	next = (float)m->w.x;
+	/* The last column/row takes what is left so rounding leaves no gap.
+	 * Cells cover the area shrunk by half a gap; each window is then shrunk
+	 * by another half, so windows are gappx apart and from the edges. */
+	a = (struct wlr_box){m->w.x + gappx / 2, m->w.y + gappx / 2,
+		m->w.width - gappx / 2 * 2, m->w.height - gappx / 2 * 2};
+	avail = (float)a.width;
+	next = (float)a.x;
 	for (i = 0; i < cols; i++) {
 		colx[i] = next;
-		colw[i] = i == cols - 1 ? (float)(m->w.x + m->w.width) - next
+		colw[i] = i == cols - 1 ? (float)(a.x + a.width) - next
 				: avail * (colper[i] / sum);
 		next += colw[i];
 	}
@@ -1971,11 +1976,11 @@ fair(Monitor *m)
 			break;
 		for (sum = 0.0f, i = 0; i < rows; i++)
 			sum += rowper[i];
-		avail = (float)m->w.height;
-		next = (float)m->w.y;
+		avail = (float)a.height;
+		next = (float)a.y;
 		for (i = 0; i < rows; i++) {
 			y[i] = next;
-			h[i] = i == rows - 1 ? (float)(m->w.y + m->w.height) - next
+			h[i] = i == rows - 1 ? (float)(a.y + a.height) - next
 					: avail * (rowper[i] / sum);
 			next += h[i];
 		}
@@ -1992,8 +1997,10 @@ fair(Monitor *m)
 		/* fullscreen and maximized clients keep their cell but not its size */
 		if (c->isfullscreen || c->ismaximized)
 			continue;
-		resize(c, (struct wlr_box){.x = (int)colx[ci], .y = (int)rowy[off + ri],
-			.width = (int)colw[ci], .height = (int)rowh[off + ri]}, 0);
+		resize(c, (struct wlr_box){.x = (int)colx[ci] + gappx / 2,
+			.y = (int)rowy[off + ri] + gappx / 2,
+			.width = (int)colw[ci] - gappx / 2 * 2,
+			.height = (int)rowh[off + ri] - gappx / 2 * 2}, 0);
 	}
 #undef CELL
 
-- 
