diff --git a/render/fx_renderer/shaders/tex.frag b/render/fx_renderer/shaders/tex.frag
index 11e3102..1104f0b 100644
--- a/render/fx_renderer/shaders/tex.frag
+++ b/render/fx_renderer/shaders/tex.frag
@@ -1,11 +1,12 @@
 #define SOURCE %d
 #define EFFECTS %d
+#define GLASS %d
 
 #define SOURCE_TEXTURE_RGBA 1
 #define SOURCE_TEXTURE_RGBX 2
 #define SOURCE_TEXTURE_EXTERNAL 3
 
-#if !defined(SOURCE) || !defined(EFFECTS)
+#if !defined(SOURCE) || !defined(EFFECTS) || !defined(GLASS)
 #error "Missing shader preamble"
 #endif
 
@@ -47,6 +48,53 @@ uniform float clip_radius_bottom_right;
 
 uniform bool discard_transparent;
 
+#if GLASS
+uniform vec2 tex_size;
+uniform float glass_thickness;
+uniform float glass_refraction;
+uniform float glass_dispersion;
+uniform float glass_rim;
+
+// Liquid glass: a flat pane whose rim curves down like a lens. Light passing
+// through the rim bends outwards, showing what lies beyond the edge, splits
+// slightly by colour, and the rim catches a specular highlight.
+vec4 sample_glass() {
+	vec2 half_size = size * 0.5;
+	vec2 p = gl_FragCoord.xy - position - half_size;
+	float r = p.y < 0.0
+		? (p.x < 0.0 ? radius_top_left : radius_top_right)
+		: (p.x < 0.0 ? radius_bottom_left : radius_bottom_right);
+	r = min(r, min(half_size.x, half_size.y));
+
+	// Signed distance to the rounded edge (negative inside) and its outward normal
+	vec2 q = abs(p) - half_size + r;
+	vec2 q_out = max(q, 0.0);
+	float dist = min(max(q.x, q.y), 0.0) + length(q_out) - r;
+	vec2 normal = q_out.x > 0.0 && q_out.y > 0.0 ? normalize(q_out)
+		: (q.x > q.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
+	normal *= sign(p);
+
+	// 0 on the flat middle, 1 at the edge. A circular rim steepens towards
+	// the edge, so the bend grows like a quarter circle.
+	float rim_pos = 1.0 - clamp(-dist / glass_thickness, 0.0, 1.0);
+	float bend = 1.0 - sqrt(1.0 - rim_pos * rim_pos);
+	vec2 offset = normal * bend * glass_refraction / tex_size;
+
+	vec4 color = vec4(
+		texture2D(tex, v_texcoord + offset * (1.0 + glass_dispersion)).r,
+		texture2D(tex, v_texcoord + offset).g,
+		texture2D(tex, v_texcoord + offset * (1.0 - glass_dispersion)).b,
+		1.0);
+
+	// Light from the top left lights that edge and, through the pane, the opposite one
+	float facing = abs(dot(normal, vec2(-0.7071, -0.7071)));
+	float edge_line = 1.0 - smoothstep(0.0, 1.5, -dist);
+	float highlight = glass_rim * (0.3 + 0.7 * facing) * (edge_line + 0.4 * rim_pos * rim_pos * rim_pos);
+	color.rgb = min(color.rgb + highlight, 1.0);
+	return color;
+}
+#endif
+
 vec4 sample_texture() {
 #if SOURCE == SOURCE_TEXTURE_RGBA || SOURCE == SOURCE_TEXTURE_EXTERNAL
 	return texture2D(tex, v_texcoord);
@@ -83,7 +131,12 @@ void main() {
 		clip_radius_bottom_right
 	);
 
-	gl_FragColor = sample_texture() * alpha * quad_corner_alpha * clip_corner_alpha;
+#if GLASS
+	vec4 tex_color = sample_glass();
+#else
+	vec4 tex_color = sample_texture();
+#endif
+	gl_FragColor = tex_color * alpha * quad_corner_alpha * clip_corner_alpha;
 #else
 	gl_FragColor = sample_texture() * alpha;
 #endif
