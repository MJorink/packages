 	return scene;
 }
@@ -1199,6 +1200,20 @@ void wlr_scene_blur_set_clipped_region(struct wlr_scene_blur *blur,
 	scene_node_update(&blur->node, NULL);
 }
 
+void wlr_scene_set_glass_data(struct wlr_scene *scene, struct glass_data glass_data) {
+	scene->glass_data = glass_data;
+	scene_node_update(&scene->tree.node, NULL);
+}
+
+void wlr_scene_blur_set_glass(struct wlr_scene_blur *blur, bool glass) {
+	if (blur->glass == glass) {
+		return;
+	}
+
+	blur->glass = glass;
+	scene_node_update(&blur->node, NULL);
+}
+
 void wlr_scene_set_blur_data(struct wlr_scene *scene, int num_passes,
 		int radius, float noise, float brightness, float contrast, float saturation) {
 	struct blur_data *buff_data = &scene->blur_data;
@@ -2209,6 +2224,13 @@ static void scene_entry_render(struct render_list_entry *entry, const struct ren
 		struct fx_corner_radii blur_corners = blur->corners;
 		fx_corner_radii_transform(node_transform, &blur_corners);
 
+		// Only the damage expanded by the blur size is re-blurred, so the
+		// refraction must not reach further than that
+		struct glass_data glass = scene->glass_data;
+		glass.thickness = fmaxf(1.0f, glass.thickness * data->scale);
+		glass.refraction = fminf(glass.refraction * data->scale,
+				blur_data_calc_size(&scene->blur_data));
+
 		struct fx_render_blur_pass_options blur_options = {
 			.tex_options = {
 				.base = (struct wlr_render_texture_options) {
@@ -2224,6 +2246,7 @@ static void scene_entry_render(struct render_list_entry *entry, const struct ren
 				.clip_box = &dst_box,
 				.corners = fx_corner_radii_scale(blur_corners, data->scale),
 				.discard_transparent = false,
+				.glass = blur->glass ? &glass : NULL,
 			},
 			.use_optimized_blur = blur->should_only_blur_bottom_layer,
 			.blur_data = &scene->blur_data,
