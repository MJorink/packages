+/* vim keys as the arrow/paging keys they stand for, except while the panel
+ * takes text (search, filter, renaming, number entry: cursorOn is set) */
+int Panel_vimKey(const Panel* this, int key) {
+   if (this->cursorOn)
+      return key;
+
+   switch (key) {
+      case 'h': return KEY_LEFT;
+      case 'j': return KEY_DOWN;
+      case 'k': return KEY_UP;
+      case 'l': return KEY_RIGHT;
+      case 'g': return KEY_HOME;
+      case 'G': return KEY_END;
+      case KEY_CTRL('B'): return KEY_PPAGE;
+      case KEY_CTRL('F'): return KEY_NPAGE;
+   }
+   return key;
+}
 
 HandlerResult Panel_selectByTyping(Panel* this, int ch) {
    int size = Panel_size(this);
