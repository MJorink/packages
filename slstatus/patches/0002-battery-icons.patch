From a6fa957375125028e4ef8dc1ce82e272635a009e Mon Sep 17 00:00:00 2001
From: jorink <maxjorink@gmail.com>
Date: Wed, 28 Oct 2026 16:35:01 +0000
Subject: [PATCH 2/3] battery-icons: Nerd Font icons for battery_state

Charging, discharging, full and not charging are shown as Nerd Font
icons instead of + - o, so the state doubles as the battery icon.
"Not charging" is the idle state (on a ThinkPad with two batteries the
one not in use, or a battery held at its charge threshold), not "on AC".

Also fixes a one-byte overflow: "Not charging" is 12 characters, read
with %12[...] into a 12-byte buffer.
---
 components/battery.c | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/components/battery.c b/components/battery.c
index 1c753f9..990604d 100644
--- a/components/battery.c
+++ b/components/battery.c
@@ -56,13 +56,14 @@
 			char *state;
 			char *symbol;
 		} map[] = {
-			{ "Charging",    "+" },
-			{ "Discharging", "-" },
-			{ "Full",        "o" },
-			{ "Not charging", "o" },
+			{ "Charging",    "\U000f0084" }, /* nf-md-battery_charging */
+			{ "Discharging", "\U000f17de" }, /* nf-md-battery_arrow_down */
+			{ "Full",        "\U000f17e2" }, /* nf-md-battery_check */
+			/* idle: e.g. BAT0 while BAT1 is used, or charge threshold reached */
+			{ "Not charging", "\U000f008e" }, /* nf-md-battery_outline */
 		};
 		size_t i;
-		char path[PATH_MAX], state[12];
+		char path[PATH_MAX], state[13];
 
 		if (esnprintf(path, sizeof(path), POWER_SUPPLY_STATUS, bat) < 0)
 			return NULL;
@@ -81,7 +82,7 @@
 	{
 		uintmax_t charge_now, current_now, m, h;
 		double timeleft;
-		char path[PATH_MAX], state[12];
+		char path[PATH_MAX], state[13];
 
 		if (esnprintf(path, sizeof(path), POWER_SUPPLY_STATUS, bat) < 0)
 			return NULL;
-- 
